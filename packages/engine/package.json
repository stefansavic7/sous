{
  "name": "sous-engine",
  "version": "0.1.0",
  "description": "Plan multi-dish meals so every dish is ready at the same time, around a real kitchen: one pair of hands, burners, oven racks and oven temperatures.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/engine.test.ts"
  },
  "keywords": ["cooking", "recipes", "meal-planning", "scheduling", "kitchen", "timer", "alexa", "mcp"],
  "license": "MIT",
  "author": "Stefan Savić",
  "repository": { "type": "git", "url": "git+https://github.com/stefansavic7/sous-engine.git" },
  "engines": { "node": ">=18" },
  "sideEffects": false
}
