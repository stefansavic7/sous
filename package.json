{
  "name": "sous-alexa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sous: an Alexa+ agent skill (MCP server) that times a whole dinner so every dish is ready at once.",
  "license": "MIT",
  "workspaces": [
    "packages/engine"
  ],
  "engines": {
    "node": ">=22.18"
  },
