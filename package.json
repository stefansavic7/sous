    "@modelcontextprotocol/server": "^2.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
